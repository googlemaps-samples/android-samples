<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/map_view_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/custom_controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:layout_marginHorizontal="8dp"
        android:scrollbars="none"
        android:background="#CC111111"
        android:padding="6dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previous_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="44dp"
                android:contentDescription="Previous Snippet"
                android:tooltipText="Previous Snippet"
                android:text="⏮" />

            <Button
                android:id="@+id/next_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="44dp"
                android:contentDescription="Next Snippet"
                android:tooltipText="Next Snippet"
                android:text="⏭" />

            <Button
                android:id="@+id/purpose_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="44dp"
                android:contentDescription="Snippet Purpose &amp; Guide"
                android:tooltipText="Snippet Purpose &amp; Guide"
                android:text="ℹ️" />

            <Button
                android:id="@+id/snapshot_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="44dp"
                android:contentDescription="Copy Camera Pose"
                android:tooltipText="Copy Camera Pose"
                android:text="📷" />

            <Button
                android:id="@+id/reset_view_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:contentDescription="Reset Map View"
                android:tooltipText="Reset Map View"
                android:text="🔄" />

        </LinearLayout>
    </HorizontalScrollView>

</FrameLayout>
