#!/bin/bash

## This hook rejects the commit if any staged change adds a Google Maps API key.
## Install it by copying this file to .git/hooks/pre-commit.

API_KEY_REGEX='AIza[0-9A-Za-z_-]{35}'

if git diff --cached -U0 --no-color | grep -E '^\+' | grep -qE "$API_KEY_REGEX"; then
    echo "Error: Commit rejected. A staged change contains a Google Maps API key."
    exit 1
fi

exit 0
